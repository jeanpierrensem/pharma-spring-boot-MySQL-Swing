<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.officine.client.ui.login.LoginController"
           stylesheets="@../css/app.css"
           styleClass="root"
           fx:id="rootPane">

    <VBox alignment="CENTER" spacing="0">
        <VBox styleClass="card" spacing="18" maxWidth="420">
            <Label text="Officine" styleClass="title"/>
            <Label text="Connectez-vous à votre espace" styleClass="subtitle"/>

            <VBox spacing="8">
                <Label text="Login" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="admin"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"/>
            </VBox>

            <CheckBox fx:id="rememberMeCheckBox" text="Se souvenir de moi"/>

            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="loginButton" text="Se connecter" styleClass="primary-button" onAction="#onLogin" defaultButton="true"/>
                <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false" prefWidth="24" prefHeight="24"/>
            </HBox>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Pas encore de compte ?" styleClass="subtitle"/>
                <Hyperlink text="Créer un compte" onAction="#onGoRegister"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
